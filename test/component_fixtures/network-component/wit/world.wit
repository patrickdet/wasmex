package test:network;

interface types {
    resource tcp-socket {
        connect: func(address: string, port: u16) -> result<_, string>;
        write: func(data: list<u8>) -> result<u32, string>;
        read: func(length: u32) -> result<list<u8>, string>;
        close: func();
    }
    
    resource udp-socket {
        bind: func(address: string, port: u16) -> result<_, string>;
        send-to: func(data: list<u8>, address: string, port: u16) -> result<u32, string>;
        receive-from: func(length: u32) -> result<tuple<list<u8>, string, u16>, string>;
        close: func();
    }
    
    resource http-client {
        request: func(method: string, url: string, headers: list<tuple<string, string>>, body: option<list<u8>>) -> result<http-response, string>;
    }
    
    resource http-response {
        status: func() -> u16;
        headers: func() -> list<tuple<string, string>>;
        body: func() -> result<list<u8>, string>;
    }
    
    create-tcp-socket: func() -> tcp-socket;
    create-udp-socket: func() -> udp-socket;
    create-http-client: func() -> http-client;
}

world network-test {
    export types;
    export test: func() -> string;
}