package test:resources@0.1.0;

interface resource-types {
  // A simple counter resource for testing
  resource counter {
    // Constructor creates a new counter with initial value
    constructor(initial: u32);
    
    // Increment the counter and return new value
    increment: func() -> u32;
    
    // Get current value without modifying
    get-value: func() -> u32;
    
    // Reset counter to a new value
    reset: func(value: u32);
  }
  
  // A blob resource for testing data storage
  resource blob {
    constructor(data: list<u8>);
    
    // Append data to the blob
    append: func(data: list<u8>);
    
    // Get the size of the blob
    size: func() -> u32;
    
    // Read data from the blob
    read: func(offset: u32, length: u32) -> list<u8>;
  }
  
  // Functions that use resources
  
  // Takes a borrowed counter and uses it
  use-counter: func(c: borrow<counter>) -> u32;
  
  // Takes ownership of a counter
  consume-counter: func(c: own<counter>) -> u32;
  
  // Creates and returns a new counter
  make-counter: func(initial: u32) -> own<counter>;
  
  // Operations with multiple resources
  add-counters: func(a: borrow<counter>, b: borrow<counter>) -> u32;
  
  // Blob operations
  duplicate-blob: func(b: borrow<blob>) -> own<blob>;
  concat-blobs: func(a: own<blob>, b: own<blob>) -> own<blob>;
}

world resource-test {
  import resource-types;
  
  export test-resources: func() -> string;
}