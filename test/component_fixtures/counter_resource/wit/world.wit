package counter:api@0.1.0;

interface counters {
    // Counter resource
    resource counter {
        // Constructor
        constructor(initial: u32);
        
        // Increment and return new value
        increment: func() -> u32;
        
        // Get current value
        get-value: func() -> u32;
        
        // Reset to new value
        reset: func(value: u32);
        
        // Add two counters together
        add: func(other: borrow<counter>) -> u32;
    }
    
    // Functions that use counter resources
    use-counter: func(c: borrow<counter>) -> u32;
    consume-counter: func(c: own<counter>) -> u32;
    make-counter: func(initial: u32) -> own<counter>;
}

world counter-world {
    export counters;
    export test-counter: func() -> string;
}